# .env.local로 복사해 값을 채운다. .env.local은 git에 올리지 않는다.
# Google Cloud 콘솔에서 Cloud Vision API를 사용 설정하고 API 키를 발급한다.
GOOGLE_VISION_API_KEY=

# Web / GitHub Actions Variables: public connection information only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local Vite adapters only. Deployed functions read Supabase Secrets instead.
FOOD_SAFETY_API_KEY=
FOOD_API_KEY=
GEMINI_API_KEY=
# Select an image-input model available for your Google project; no default model is guessed.
GEMINI_MODEL=

# 이메일 알림 테스트 발송 (scripts/send-test-email.mjs). 배포 worker는 Supabase Secrets에 같은 이름으로 넣는다.
# 도메인 인증 전에는 EMAIL_FROM=콕집서 <onboarding@resend.dev> 로, Resend 가입 메일 주소로만 받을 수 있다.
RESEND_API_KEY=
EMAIL_FROM=
# Gmail SMTP 로컬 테스트용 (pnpm email:test 받는주소 --gmail). 2단계 인증 후 발급한 16자리 앱 비밀번호.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# --from-db 테스트용. 모든 사용자 데이터를 읽을 수 있는 키라 절대 공유·커밋하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
